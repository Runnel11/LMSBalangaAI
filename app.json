{
  "expo": {
  "name": "BalangaAI",
  "slug": "ai-lms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ailms",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses location to show relevant events and content in your area.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app uses location to show relevant events and content in your area.",
        "NSCameraUsageDescription": "This app may use the camera to capture photos for profile or content sharing.",
        "NSPhotoLibraryUsageDescription": "This app may access your photo library to select images for profile or content sharing.",
        "NSMicrophoneUsageDescription": "This app may use the microphone for voice features or content recording."
      }
    },
    "android": {
      "name": "BalangaAI",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.runnel.ailms",
      "navigationBarColor": "#EEEFF4",
      "softwareKeyboardLayoutMode": "adjustResize",
      "enableProguardInReleaseBuilds": true,
      "enableSeparateBuildPerCPUArchitecture": true,
      "universalApk": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "READ_EXTERNAL_STORAGE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO"
      ],
      "blockedPermissions": [
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dde4f7ee-0cc9-47c1-8e36-98fc9394b988"
      }
    },
    "owner": "runnel"
  }
}
